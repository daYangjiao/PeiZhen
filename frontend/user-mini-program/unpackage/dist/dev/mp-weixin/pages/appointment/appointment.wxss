
.container {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
	padding-bottom: 120rpx;
}
.header {
	text-align: center;
	padding: 40rpx 0;
}
.title {
	font-size: 36rpx;
	font-weight: bold;
	color: #333;
}

/* 服务类型选择 */
.service-types {
	margin-bottom: 40rpx;
	padding: 20rpx;
}
.service-row {
	display: flex;
	justify-content: space-between;
	margin-bottom: 20rpx;
	gap: 20rpx;
}
.service-item {
	flex: 1;
	height: 200rpx;
	background-color: white;
	border-radius: 16rpx;
	padding: 30rpx 20rpx;
	box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	text-align: center;
	transition: all 0.3s ease;
	border: 2rpx solid transparent;
}
.service-item.selected {
	background: linear-gradient(135deg, #f0f8ff 0%, #e6f3ff 100%);
	border: 2rpx solid #4a90e2;
	box-shadow: 0 6rpx 16rpx rgba(74, 144, 226, 0.2);
	transform: translateY(-2rpx);
}
.service-item.selected .service-title {
	color: #4a90e2;
	font-weight: 600;
}
.service-item.selected .service-desc {
	color: #666;
}
.service-icon {
	width: 80rpx;
	height: 80rpx;
	margin-bottom: 20rpx;
}
.service-title {
	font-size: 28rpx;
	font-weight: bold;
	color: #333;
	margin-bottom: 10rpx;
}
.service-desc {
	font-size: 24rpx;
	color: #666;
	line-height: 1.4;
}

/* 服务详情 */
.service-details {
	background-color: white;
	border-radius: 20rpx;
	padding: 40rpx;
	margin-bottom: 40rpx;
	box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}
.details-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #333;
	margin-bottom: 30rpx;
	display: block;
}
.detail-item {
	display: flex;
	align-items: center;
	margin-bottom: 20rpx;
}
.detail-icon {
	width: 40rpx;
	height: 40rpx;
	margin-right: 20rpx;
}
.detail-text {
	font-size: 28rpx;
	color: #666;
	line-height: 1.5;
}

/* 推荐陪诊员 */
.recommended-section {
	margin-bottom: 40rpx;
}
.section-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #333;
	margin-bottom: 30rpx;
	display: block;
}
.companion-list {
	display: flex;
	flex-direction: column;
	gap: 20rpx;
}
.companion-card {
	background-color: white;
	border-radius: 20rpx;
	padding: 30rpx;
	box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
	display: flex;
	align-items: center;
	transition: all 0.3s ease;
	border: 2rpx solid transparent;
}
.companion-card.selected {
	background: linear-gradient(135deg, #f0f8ff 0%, #e6f3ff 100%);
	border: 2rpx solid #4a90e2;
	box-shadow: 0 6rpx 16rpx rgba(74, 144, 226, 0.2);
	transform: translateY(-2rpx);
}
.companion-card.selected .companion-name {
	color: #4a90e2;
	font-weight: 600;
}
.companion-avatar {
	width: 120rpx;
	height: 120rpx;
	border-radius: 50%;
	margin-right: 30rpx;
}
.companion-info {
	flex: 1;
}
.companion-name {
	font-size: 32rpx;
	font-weight: bold;
	color: #333;
	margin-bottom: 10rpx;
	display: block;
}
.companion-rating {
	display: flex;
	align-items: center;
	margin-bottom: 15rpx;
}
.rating-star {
	color: #FFD700;
	font-size: 24rpx;
	margin-right: 8rpx;
}
.rating-score {
	font-size: 24rpx;
	color: #333;
	margin-right: 10rpx;
}
.rating-count {
	font-size: 22rpx;
	color: #999;
	margin-right: 20rpx;
}
.experience {
	font-size: 22rpx;
	color: #666;
}
.companion-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 10rpx;
}
.tag {
	background-color: #E3F2FD;
	color: #1976D2;
	font-size: 20rpx;
	padding: 8rpx 16rpx;
	border-radius: 20rpx;
}
.companion-price {
	font-size: 28rpx;
	font-weight: bold;
	color: #1976D2;
}

/* 底部按钮 */
.bottom-button {
	position: fixed;
	bottom: 0;
	left: 0;
	right: 0;
	padding: 30rpx;
	background-color: white;
	border-top: 1rpx solid #eee;
}
.next-btn {
	width: 100%;
	height: 88rpx;
	background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
	color: white;
	font-size: 32rpx;
	font-weight: bold;
	border-radius: 44rpx;
	border: none;
	display: flex;
	align-items: center;
	justify-content: center;
}
.next-btn:active {
	opacity: 0.8;
}
