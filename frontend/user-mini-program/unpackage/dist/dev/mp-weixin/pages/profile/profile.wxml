<view class="container"><view class="user-section"><view wx:if="{{a}}" class="user-info"><view class="user-avatar"><image class="avatar-img" src="{{b}}" mode="aspectFill" binderror="{{c}}"></image></view><view class="user-details"><text class="user-name">{{d}}</text><text class="user-desc">{{e}}</text></view><view class="user-actions"><view class="action-btn" bindtap="{{f}}"><text class="action-text">编辑</text></view></view></view><view wx:else class="login-prompt"><view class="prompt-icon"><image class="icon-img" src="{{g}}" mode="aspectFit"></image></view><text class="prompt-title">您还未登录</text><text class="prompt-desc">登录后可享受更多个性化服务</text><button class="login-btn" bindtap="{{h}}"><text class="btn-text">立即登录</text></button></view></view><view class="menu-section"><view class="menu-group"><text class="group-title">我的服务</text><view class="menu-list"><view class="menu-item" bindtap="{{j}}"><view class="item-icon"><image src="{{i}}" mode="aspectFit"></image></view><text class="item-title">我的订单</text><text class="item-arrow">〉</text></view><view class="menu-item" bindtap="{{l}}"><view class="item-icon"><image src="{{k}}" mode="aspectFit"></image></view><text class="item-title">我的预约</text><text class="item-arrow">〉</text></view><view class="menu-item" bindtap="{{n}}"><view class="item-icon"><image src="{{m}}" mode="aspectFit"></image></view><text class="item-title">消息中心</text><text class="item-arrow">〉</text></view></view></view><view class="menu-group"><text class="group-title">设置</text><view class="menu-list"><view class="menu-item" bindtap="{{p}}"><view class="item-icon"><image src="{{o}}" mode="aspectFit"></image></view><text class="item-title">设置</text><text class="item-arrow">〉</text></view><view class="menu-item" bindtap="{{r}}"><view class="item-icon"><image src="{{q}}" mode="aspectFit"></image></view><text class="item-title">帮助与反馈</text><text class="item-arrow">〉</text></view><view wx:if="{{s}}" class="menu-item" bindtap="{{v}}"><view class="item-icon"><image src="{{t}}" mode="aspectFit"></image></view><text class="item-title logout-text">退出登录</text><text class="item-arrow">〉</text></view></view></view></view></view>