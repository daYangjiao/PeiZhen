
.container {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}
.header {
	background-color: white;
	border-radius: 20rpx;
	padding: 40rpx;
	margin-bottom: 30rpx;
	text-align: center;
}
.title {
	font-size: 36rpx;
	font-weight: bold;
	color: #333;
}
.content {
	background-color: white;
	border-radius: 20rpx;
	padding: 80rpx 40rpx;
	text-align: center;
}
.placeholder {
	font-size: 28rpx;
	color: #999;
}
