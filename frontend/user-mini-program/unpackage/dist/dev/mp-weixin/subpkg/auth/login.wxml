<view class="login-container"><view class="header-decoration"><view class="decoration-circle circle1"></view><view class="decoration-circle circle2"></view><view class="decoration-circle circle3"></view></view><view class="logo-section"><image class="logo" src="{{a}}" mode="aspectFit"></image><text class="app-name">愈安伴</text><text class="app-desc">专业贴心的医疗陪护服务</text></view><view class="login-section"><view class="login-card"><text class="login-title">欢迎使用陪诊服务</text><text class="login-subtitle">请使用账号密码登录</text><view class="login-form"><view class="input-group"><input class="form-input" type="text" placeholder="请输入用户名" value="{{b}}" bindinput="{{c}}"/></view><view class="input-group"><input class="form-input" type="password" placeholder="请输入密码" value="{{d}}" bindinput="{{e}}"/></view><button class="login-btn" bindtap="{{f}}" loading="{{g}}"> 登录 </button></view><view class="register-link"><text class="link-text">没有账号？</text><text class="link-action" bindtap="{{h}}">立即注册</text></view></view></view><view class="footer-info"><view class="agreement-checkbox"><checkbox checked="{{i}}" bindtap="{{j}}"/><text class="agreement-text">我已阅读并同意</text><text class="link-text" bindtap="{{k}}">《隐私政策》</text><text class="agreement-text">和</text><text class="link-text" bindtap="{{l}}">《服务条款》</text></view><text wx:if="{{m}}" class="error-text agreement-error">{{n}}</text></view></view>