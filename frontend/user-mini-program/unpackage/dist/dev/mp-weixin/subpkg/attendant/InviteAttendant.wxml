<view class="invite-attendant-page data-v-139efa28"><view class="nav-bar data-v-139efa28"><navigator url="/pages/order/order" class="back-btn data-v-139efa28"><text class="iconfont icon-back data-v-139efa28"> 返回</text></navigator><text class="page-title data-v-139efa28">邀请陪诊师接单</text></view><view class="order-summary data-v-139efa28"><view class="order-header data-v-139efa28"><text class="order-title data-v-139efa28">订单信息</text></view><view class="order-details data-v-139efa28"><view class="detail-item data-v-139efa28"><text class="label data-v-139efa28">订单号：</text><text class="value data-v-139efa28">{{a}}</text></view><view class="detail-item data-v-139efa28"><text class="label data-v-139efa28">服务时间：</text><text class="value data-v-139efa28">{{b}}</text></view><view class="detail-item data-v-139efa28"><text class="label data-v-139efa28">服务医院：</text><text class="value data-v-139efa28">{{c}}</text></view></view></view><view class="filter-section data-v-139efa28"><view class="filter-header data-v-139efa28"><text class="filter-title data-v-139efa28">筛选条件</text></view><view class="filter-options data-v-139efa28"><picker class="data-v-139efa28" mode="date" value="{{e}}" bindchange="{{f}}"><view class="filter-item data-v-139efa28"><text class="filter-label data-v-139efa28">日期：</text><text class="filter-value data-v-139efa28">{{d}}</text></view></picker><picker class="data-v-139efa28" range="{{h}}" bindchange="{{i}}"><view class="filter-item data-v-139efa28"><text class="filter-label data-v-139efa28">时段：</text><text class="filter-value data-v-139efa28">{{g}}</text></view></picker><view class="filter-item data-v-139efa28"><text class="filter-label data-v-139efa28">专业：</text><input class="filter-input data-v-139efa28" placeholder="请输入专业领域" bindconfirm="{{j}}" value="{{k}}" bindinput="{{l}}"/></view></view><button class="search-btn data-v-139efa28" bindtap="{{m}}">搜索陪诊师</button></view><view wx:if="{{n}}" class="loading-container data-v-139efa28"><text class="data-v-139efa28">正在加载陪诊师信息...</text></view><view wx:else class="attendant-list data-v-139efa28"><view class="list-header data-v-139efa28"><text class="list-title data-v-139efa28">可预约陪诊师 ({{o}}位)</text></view><view wx:for="{{p}}" wx:for-item="attendant" wx:key="n" class="attendant-card data-v-139efa28" bindtap="{{attendant.o}}"><image src="{{attendant.a}}" class="attendant-avatar data-v-139efa28" mode="aspectFill" binderror="{{attendant.b}}"/><view class="attendant-info data-v-139efa28"><view class="attendant-basic data-v-139efa28"><text class="attendant-name data-v-139efa28">{{attendant.c}}</text><text class="attendant-score data-v-139efa28">⭐ {{attendant.d}}</text></view><text class="attendant-intro data-v-139efa28">{{attendant.e}}</text><view class="attendant-details data-v-139efa28"><text class="detail-tag data-v-139efa28">{{attendant.f}}</text><text class="detail-tag data-v-139efa28">{{attendant.g}}年经验</text><text class="detail-tag data-v-139efa28">¥{{attendant.h}}/次</text></view><view class="available-times data-v-139efa28"><text class="times-label data-v-139efa28">可预约时间：</text><view class="time-tags data-v-139efa28"><text wx:for="{{attendant.i}}" wx:for-item="time" wx:key="b" class="time-tag data-v-139efa28">{{time.a}}</text></view></view></view><button class="{{['invite-btn', 'data-v-139efa28', attendant.k && 'invited']}}" catchtap="{{attendant.l}}" disabled="{{attendant.m}}">{{attendant.j}}</button></view><view wx:if="{{q}}" class="empty-state data-v-139efa28"><image class="empty-icon data-v-139efa28" src="{{r}}" mode="aspectFit"></image><text class="empty-text data-v-139efa28">暂无可预约的陪诊师</text><text class="empty-subtext data-v-139efa28">请调整筛选条件或稍后再试</text></view></view><view wx:if="{{s}}" class="modal-overlay data-v-139efa28" bindtap="{{y}}"><view class="modal-content data-v-139efa28" catchtap="{{x}}"><view class="modal-header data-v-139efa28"><text class="modal-title data-v-139efa28">邀请陪诊师</text></view><view class="modal-body data-v-139efa28"><text class="modal-text data-v-139efa28">确定要邀请 {{t}} 接单吗？</text><text class="modal-desc data-v-139efa28">邀请后陪诊师将在其端收到接单通知</text></view><view class="modal-footer data-v-139efa28"><button class="modal-btn cancel-btn data-v-139efa28" bindtap="{{v}}">取消</button><button class="modal-btn confirm-btn data-v-139efa28" bindtap="{{w}}">确定邀请</button></view></view></view></view>