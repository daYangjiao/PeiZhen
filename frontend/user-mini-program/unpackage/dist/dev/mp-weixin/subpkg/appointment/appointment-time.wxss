
.appointment-time-container.data-v-8067b228 {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding-bottom: 120rpx;
}

/* 状态栏占位 */
.status-bar.data-v-8067b228 {
	background-color: #ffffff;
}

/* 顶部标题 */
.header.data-v-8067b228 {
	padding: 20rpx;
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: #fff;
}
.back-btn.data-v-8067b228 {
	position: absolute;
	left: 20rpx;
	width: 80rpx;
	height: 80rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.back-icon.data-v-8067b228 {
	font-size: 50rpx;
	color: #666;
	font-weight: normal;
}
.title.data-v-8067b228 {
	font-size: 36rpx;
	font-weight: bold;
	color: #333;
}

/* 日期选择区域 */
.date-section.data-v-8067b228 {
	background-color: #ffffff;
	margin: 20rpx 30rpx;
	border-radius: 20rpx;
	padding: 40rpx 30rpx;
	text-align: center;
}
.date-picker-wrapper.data-v-8067b228 {
	display: inline-block;
	margin-bottom: 30rpx;
}
.date-btn.data-v-8067b228 {
	background: linear-gradient(135deg, #4A90E2, #357ABD);
	color: white;
	padding: 20rpx 60rpx;
	border-radius: 50rpx;
	display: inline-block;
}
.date-text.data-v-8067b228 {
	font-size: 32rpx;
	font-weight: 600;
}
.selected-date.data-v-8067b228 {
	padding: 10rpx 0;
}
.placeholder-text.data-v-8067b228 {
	color: #999;
	font-size: 28rpx;
}
.date-value.data-v-8067b228 {
	color: #333;
	font-size: 32rpx;
	font-weight: 600;
}

/* 时间选择区域 */
.time-section.data-v-8067b228 {
	background-color: #ffffff;
	margin: 20rpx 30rpx;
	border-radius: 20rpx;
	padding: 40rpx 30rpx;
}
.section-header.data-v-8067b228 {
	display: flex;
	align-items: center;
	margin-bottom: 30rpx;
}
.icon-wrapper.data-v-8067b228 {
	width: 60rpx;
	height: 60rpx;
	background-color: #E3F2FD;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-right: 20rpx;
}
.time-icon.data-v-8067b228, .location-icon.data-v-8067b228 {
	font-size: 28rpx;
}
.section-title.data-v-8067b228 {
	font-size: 32rpx;
	font-weight: 600;
	color: #333;
}
.time-picker-row.data-v-8067b228 {
	display: flex;
	gap: 30rpx;
}
.time-picker.data-v-8067b228 {
	flex: 1;
	background-color: #f8f9fa;
	border-radius: 15rpx;
	padding: 30rpx 20rpx;
	display: flex;
	align-items: center;
	justify-content: space-between;
	border: 2rpx solid #e9ecef;
}
.time-label.data-v-8067b228 {
	font-size: 28rpx;
	color: #666;
}
.time-value.data-v-8067b228 {
	font-size: 28rpx;
	color: #333;
	font-weight: 600;
}
.time-placeholder.data-v-8067b228 {
	font-size: 28rpx;
	color: #999;
}
.time-arrow.data-v-8067b228 {
	font-size: 24rpx;
	color: #999;
}

/* 地址输入区域 */
.location-section.data-v-8067b228 {
	background-color: #ffffff;
	margin: 20rpx 30rpx;
	border-radius: 20rpx;
	padding: 40rpx 30rpx;
}
.location-input.data-v-8067b228 {
	background-color: #f8f9fa;
	border-radius: 15rpx;
	padding: 5rpx 20rpx;
	border: 2rpx solid #e9ecef;
}
.address-input.data-v-8067b228 {
	width: 100%;
	padding: 25rpx 0;
	font-size: 28rpx;
	color: #333;
	background: transparent;
	border: none;
	outline: none;
}

/* 联系信息区域 */
.contact-section.data-v-8067b228 {
	margin: 20rpx 30rpx;
	gap: 20rpx;
	display: flex;
	flex-direction: column;
}
.input-group.data-v-8067b228 {
	background-color: #ffffff;
	border-radius: 15rpx;
	padding: 5rpx 30rpx;
}
.contact-input.data-v-8067b228 {
	width: 100%;
	padding: 35rpx 0;
	font-size: 28rpx;
	color: #333;
	background: transparent;
	border: none;
	outline: none;
}
.error-text.data-v-8067b228 {
	font-size: 24rpx;
	color: #ff4757;
	margin-top: 8rpx;
	padding-left: 24rpx;
}

/* 确认按钮 */
.confirm-section.data-v-8067b228 {
	position: fixed;
	bottom: 0;
	left: 0;
	right: 0;
	background-color: #ffffff;
	padding: 30rpx;
	border-top: 1rpx solid #eee;
}
.confirm-btn.data-v-8067b228 {
	width: 100%;
	height: 88rpx;
	background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
	color: white;
	font-size: 32rpx;
	font-weight: bold;
	border-radius: 44rpx;
	border: none;
	display: flex;
	align-items: center;
	justify-content: center;
}

/* 弹窗样式 */
.modal-overlay.data-v-8067b228 {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 0.5);
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 1000;
}
.date-modal.data-v-8067b228, .time-modal.data-v-8067b228 {
	background-color: #ffffff;
	border-radius: 20rpx;
	width: 80%;
	max-height: 80%;
	overflow: hidden;
}
.modal-header.data-v-8067b228 {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 30rpx;
	border-bottom: 1rpx solid #eee;
}
.modal-title.data-v-8067b228 {
	font-size: 32rpx;
	font-weight: 600;
	color: #333;
}
.close-btn.data-v-8067b228 {
	font-size: 32rpx;
	color: #999;
}
.time-list.data-v-8067b228 {
	max-height: 400rpx;
	overflow-y: auto;
	padding: 20rpx;
}
.time-option.data-v-8067b228 {
	padding: 25rpx 30rpx;
	margin: 10rpx 0;
	border-radius: 15rpx;
	background-color: #f8f9fa;
	text-align: center;
	font-size: 28rpx;
	color: #333;
	transition: all 0.3s ease;
}
.time-option.selected.data-v-8067b228 {
	background: linear-gradient(135deg, #4A90E2, #357ABD);
	color: white;
}
.modal-footer.data-v-8067b228 {
	display: flex;
	padding: 30rpx;
	gap: 20rpx;
	border-top: 1rpx solid #eee;
}
.cancel-btn.data-v-8067b228 {
	flex: 1;
	background-color: #f8f9fa;
	color: #666;
	border: none;
	border-radius: 25rpx;
	padding: 25rpx 0;
	font-size: 28rpx;
}
.confirm-time-btn.data-v-8067b228 {
	flex: 1;
	background: linear-gradient(135deg, #4A90E2, #357ABD);
	color: white;
	border: none;
	border-radius: 25rpx;
	padding: 25rpx 0;
	font-size: 28rpx;
	font-weight: 600;
}
