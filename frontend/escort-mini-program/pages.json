	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "陪诊师",
		"navigationBarBackgroundColor": "#ffffff",
		"backgroundColor": "#f5f5f5"
	},
	"tabBar": {
		"color": "#999999",
		"selectedColor": "#4A90E2",
		"backgroundColor": "#ffffff",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "接单厅",
				"iconPath": "static/shouye.png",
				"selectedIconPath": "static/shouye_active.png"
			},
			{
				"pagePath": "pages/order/order",
				"text": "订单",
				"iconPath": "static/order.png",
				"selectedIconPath": "static/order_active.png"
			},
			{
				"pagePath": "pages/message/message",
				"text": "消息",
				"iconPath": "static/xiaoxi_2.png",
				"selectedIconPath": "static/xiaoxi_2_active.png"
			},
			{
				"pagePath": "pages/profile/profile",
				"text": "我的",
				"iconPath": "static/wode_2.png",
				"selectedIconPath": "static/wode_2_active.png"
			}
		]
