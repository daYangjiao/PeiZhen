	"subPackages": [
		{
			"root": "subpkg/auth",
			"pages": [
				{
					"path": "login",
					"style": {
						"navigationBarTitleText": "登录",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "register",
					"style": {
						"navigationBarTitleText": "陪诊师入驻",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "subpkg/order",
			"pages": [
				{
					"path": "detail",
					"style": {
						"navigationStyle": "custom",
						"backgroundColor": "#f8f9fa"
					}
				}
			]
		},
		{
			"root": "subpkg/chat",
			"pages": [
				{
					"path": "chat",
					"style": {
						"navigationBarTitleText": "聊天",
						"navigationStyle": "custom",
						"enablePullDownRefresh": false,
						"app-plus": {
						"titleNView": false
						}
					}
				}
				
			]
		},
		{
			"root": "subpkg/system-message",
			"pages": [
				{
					"path": "system-message",
					"style": {
						"navigationBarTitleText": "系统通知"
					}
				}
			]
		}
	],
	"uniIdRouter": {
		"loginPage": "subpkg/auth/login",
		"needLogin": [
			"pages/index/index",
			"pages/order/order",
			"pages/message/message",
			"pages/profile/profile"
		]
	}
