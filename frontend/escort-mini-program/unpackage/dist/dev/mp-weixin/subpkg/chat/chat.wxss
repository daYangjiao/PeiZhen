@keyframes messageSlideIn {
from {
    opacity: 0;
    transform: translateY(20px);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}
@keyframes bubbleScale {
from {
    opacity: 0;
    transform: scale(0.8);
}
to {
    opacity: 1;
    transform: scale(1);
}
}
@keyframes statusPulse {
0%, 100% {
    opacity: 1;
    transform: scale(1);
}
50% {
    opacity: 0.6;
    transform: scale(0.9);
}
}
@keyframes shake {
0%, 100% {
    transform: translateX(0);
}
25% {
    transform: translateX(-2px);
}
75% {
    transform: translateX(2px);
}
}
.message-menu {
