<view class="container"><view class="custom-navbar"><view class="navbar-content"><view class="nav-left" bindtap="{{b}}"><image class="back-icon" src="{{a}}" mode="aspectFit"></image></view><view class="nav-title">订单详情</view><view class="nav-right"></view></view></view><view wx:if="{{c}}" class="loading"><text>加载中...</text></view><scroll-view wx:else class="content" scroll-y><view class="status-card"><view class="status-info"><image class="status-icon" src="{{d}}" mode="aspectFit"></image><view class="status-text"><text class="status-title">{{e}}</text><text class="status-desc">{{f}}</text></view></view><view class="order-no">订单号：{{g}}</view></view><view class="info-card"><view class="card-title"><image class="title-icon" src="{{h}}" mode="aspectFit"></image><text>患者信息</text></view><view class="patient-info"><view class="patient-avatar"><image src="{{i}}" mode="aspectFill"></image></view><view class="patient-details"><view class="patient-name">{{j}}</view><view class="patient-meta"><text>{{k}}岁</text><text>{{l}}</text><text>{{m}}</text></view></view><view class="contact-btn" bindtap="{{o}}"><image src="{{n}}" mode="aspectFit"></image></view></view></view><view class="info-card"><view class="card-title"><image class="title-icon" src="{{p}}" mode="aspectFit"></image><text>服务信息</text></view><view class="service-info"><view class="info-row"><text class="label">服务类型</text><text class="value">{{q}}</text></view><view class="info-row"><text class="label">医院</text><text class="value">{{r}}</text></view><view class="info-row"><text class="label">预约时间</text><text class="value">{{s}}</text></view><view wx:if="{{t}}" class="info-row"><text class="label">预约结束时间</text><text class="value">{{v}}</text></view><view wx:if="{{w}}" class="info-row"><text class="label">服务时长</text><text class="value">{{x}}</text></view></view></view><view wx:if="{{y}}" class="info-card"><view class="card-title"><image class="title-icon" src="{{z}}" mode="aspectFit"></image><text>特殊需求</text></view><view class="special-requests"><text>{{A}}</text></view></view><view class="info-card"><view class="card-title"><image class="title-icon" src="{{B}}" mode="aspectFit"></image><text>费用信息</text></view><view class="fee-info"><view class="fee-row"><text class="fee-label">服务费</text><text class="fee-value">¥{{C}}</text></view><view wx:if="{{D}}" class="fee-row"><text class="fee-label">平台服务费</text><text class="fee-value">¥{{E}}</text></view><view class="fee-row total"><text class="fee-label">总计</text><text class="fee-value total-price">¥{{F}}</text></view></view></view><view wx:if="{{G}}" class="info-card"><view class="card-title"><image class="title-icon" src="{{H}}" mode="aspectFit"></image><text>陪诊流程</text></view><view class="process-timeline"><view wx:for="{{I}}" wx:for-item="step" wx:key="f" class="{{['timeline-item', step.g && 'active', step.h && 'current']}}"><view class="timeline-dot"></view><view class="timeline-content"><view class="step-title">{{step.a}}</view><view wx:if="{{step.b}}" class="step-time">{{step.c}}</view><view wx:if="{{step.d}}" class="step-desc">{{step.e}}</view></view></view></view></view><view wx:if="{{J}}" class="info-card"><view class="card-title"><image class="title-icon" src="{{K}}" mode="aspectFit"></image><text>服务记录</text></view><view class="service-records"><view wx:for="{{L}}" wx:for-item="record" wx:key="c" class="record-item"><view class="record-time">{{record.a}}</view><view class="record-content">{{record.b}}</view></view></view></view></scroll-view><view wx:if="{{M}}" class="bottom-actions"><button class="action-btn secondary" bindtap="{{N}}">联系患者</button><button class="action-btn primary" bindtap="{{P}}">{{O}}</button></view></view>