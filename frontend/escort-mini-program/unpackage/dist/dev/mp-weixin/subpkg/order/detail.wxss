.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  padding-top: var(--status-bar-height);
  background-color: #4A90E2;
}
.custom-navbar .navbar-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 15px;
}
.custom-navbar .navbar-content .nav-left, .custom-navbar .navbar-content .nav-right {
  width: 60px;
  height: 44px;
  display: flex;
  align-items: center;
}
.custom-navbar .navbar-content .back-icon {
  width: 24px;
  height: 24px;
  filter: brightness(0) invert(1);
}
.custom-navbar .navbar-content .nav-title {
  flex: 1;
  text-align: center;
  font-size: 18px;
  font-weight: 600;
  color: #ffffff;
}
.content {
  padding-top: calc(var(--status-bar-height) + 44px);
  padding-bottom: 80px;
}
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200px;
  color: #666;
  font-size: 16px;
}
.status-card {
  background-color: #ffffff;
  margin: 15px;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}
.status-card .status-info {
  display: flex;
  align-items: center;
  margin-bottom: 15px;
}
.status-card .status-info .status-icon {
  width: 40px;
  height: 40px;
  margin-right: 15px;
}
.status-card .status-info .status-text {
  flex: 1;
}
.status-card .status-info .status-text .status-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 5px;
}
.status-card .status-info .status-text .status-desc {
  font-size: 14px;
  color: #666;
  display: block;
}
.status-card .order-no {
  font-size: 14px;
  color: #999;
}
.info-card {
  background-color: #ffffff;
  margin: 0 15px 15px;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}
.info-card .card-title {
  display: flex;
  align-items: center;
  margin-bottom: 15px;
}
.info-card .card-title .title-icon {
  width: 20px;
  height: 20px;
  margin-right: 8px;
  opacity: 0.8;
}
.info-card .card-title text {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}
.patient-info {
  display: flex;
  align-items: center;
}
.patient-info .patient-avatar {
  width: 50px;
  height: 50px;
  border-radius: 25px;
  overflow: hidden;
  margin-right: 15px;
}
.patient-info .patient-avatar image {
  width: 100%;
  height: 100%;
}
.patient-info .patient-details {
  flex: 1;
}
.patient-info .patient-details .patient-name {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 5px;
}
.patient-info .patient-details .patient-meta {
  font-size: 14px;
  color: #666;
}
.patient-info .patient-details .patient-meta text {
  margin-right: 15px;
}
.patient-info .contact-btn {
  width: 40px;
  height: 40px;
  background-color: #4A90E2;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.patient-info .contact-btn image {
  width: 20px;
  height: 20px;
  filter: brightness(0) invert(1);
}
.service-info .info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
}
.service-info .info-row:last-child {
  border-bottom: none;
}
.service-info .info-row .label {
  font-size: 14px;
  color: #666;
}
.service-info .info-row .value {
  font-size: 14px;
  color: #333;
  font-weight: 500;
}
.special-requests {
  padding: 15px;
  background-color: #f8f9fa;
  border-radius: 8px;
  font-size: 14px;
  color: #666;
  line-height: 1.5;
}
.fee-info .fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
}
.fee-info .fee-row .fee-label {
  font-size: 14px;
  color: #666;
}
.fee-info .fee-row .fee-value {
  font-size: 14px;
  color: #333;
  font-weight: 500;
}
.fee-info .fee-row.total {
  border-top: 1px solid #f0f0f0;
  padding-top: 15px;
  margin-top: 5px;
}
.fee-info .fee-row.total .fee-label {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}
.fee-info .fee-row.total .total-price {
  font-size: 18px;
  font-weight: 600;
  color: #ff6b6b;
}
.process-timeline .timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 20px;
}
.process-timeline .timeline-item:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 8px;
  top: 20px;
  width: 2px;
  height: calc(100% - 10px);
  background-color: #e0e0e0;
}
.process-timeline .timeline-item.active::after {
  background-color: #4A90E2;
}
.process-timeline .timeline-item .timeline-dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background-color: #e0e0e0;
  border: 3px solid #ffffff;
  box-shadow: 0 0 0 2px #e0e0e0;
  margin-right: 15px;
  flex-shrink: 0;
  margin-top: 2px;
}
.process-timeline .timeline-item.active .timeline-dot {
  background-color: #4A90E2;
  box-shadow: 0 0 0 2px #4A90E2;
}
.process-timeline .timeline-item.current .timeline-dot {
  background-color: #ff9500;
  box-shadow: 0 0 0 2px #ff9500;
  animation: pulse 2s infinite;
}
.process-timeline .timeline-item .timeline-content {
  flex: 1;
}
.process-timeline .timeline-item .timeline-content .step-title {
  font-size: 15px;
  font-weight: 600;
  color: #333;
  margin-bottom: 4px;
}
.process-timeline .timeline-item .timeline-content .step-time {
  font-size: 12px;
  color: #4A90E2;
  margin-bottom: 4px;
}
.process-timeline .timeline-item .timeline-content .step-desc {
  font-size: 13px;
  color: #666;
  line-height: 1.4;
}
.process-timeline .timeline-item.active .timeline-content .step-title {
  color: #4A90E2;
}
.process-timeline .timeline-item.current .timeline-content .step-title {
  color: #ff9500;
}
@keyframes pulse {
0% {
    box-shadow: 0 0 0 2px #ff9500, 0 0 0 4px rgba(255, 149, 0, 0.3);
}
50% {
    box-shadow: 0 0 0 2px #ff9500, 0 0 0 8px rgba(255, 149, 0, 0.1);
}
100% {
    box-shadow: 0 0 0 2px #ff9500, 0 0 0 4px rgba(255, 149, 0, 0.3);
}
}
.service-records .record-item {
  padding: 15px 0;
  border-bottom: 1px solid #f0f0f0;
}
.service-records .record-item:last-child {
  border-bottom: none;
}
.service-records .record-item .record-time {
  font-size: 12px;
  color: #999;
  margin-bottom: 5px;
}
.service-records .record-item .record-content {
  font-size: 14px;
  color: #333;
  line-height: 1.5;
}
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 15px;
  border-top: 1px solid #f0f0f0;
  display: flex;
  gap: 10px;
}
.bottom-actions .action-btn {
  flex: 1;
  height: 44px;
  border-radius: 22px;
  font-size: 14px;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}
.bottom-actions .action-btn.secondary {
  background-color: #f8f9fa;
  color: #666;
  border: 1px solid #e0e0e0;
}
.bottom-actions .action-btn.secondary:active {
  background-color: #e9ecef;
  transform: scale(0.98);
}
.bottom-actions .action-btn.primary {
  background-color: #4A90E2;
  color: #ffffff;
  flex: 1.2;
}
.bottom-actions .action-btn.primary:active {
  background-color: #3a7bc8;
  transform: scale(0.98);
}