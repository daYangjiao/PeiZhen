# Gitee webhook authentication.
# Put the same token into Gitee WebHook "密码/Token".
GITEE_WEBHOOK_TOKEN=replace-with-a-long-random-token

# Production source.
GITEE_REPO_URL=https://gitee.com/wkq-karry/master.git
AUTODEPLOY_BRANCH=FF

# Local autodeploy paths on the server.
AUTODEPLOY_ROOT=/opt/pz-autodeploy
AUTODEPLOY_SOURCE_DIR=/opt/pz-autodeploy/source
AUTODEPLOY_LOG_DIR=/var/log/pz-autodeploy
AUTODEPLOY_SCRIPT=/opt/pz-autodeploy/bin/autodeploy-run.sh
AUTODEPLOY_POLL_STATE_FILE=/opt/pz-autodeploy/last-ff-commit

# Runtime paths.
REMOTE_ROOT=/home/ops/PZ_yuanbao
WEB_ROOT=/var/www/pz-mini
SERVICE_NAME=pz-app

# Linux HBuilderX CLI.
# Optional. Leave blank to let install-autodeploy.sh resolve the current Linux
# tar.gz from https://download1.dcloud.net.cn/hbuilderx/release.json.
HBUILDERX_DOWNLOAD_URL=
HBUILDERX_DIR=/opt/HBuilderX
HBUILDERX_CLI=/opt/HBuilderX/cli
HBUILDERX_PROJECT_PATH=/opt/pz-autodeploy/source/frontend/mini-program
HBUILDERX_OPEN_TIMEOUT=45s
HBUILDERX_COMMAND_TIMEOUT=300s
HBUILDERX_PUBLISH_TIMEOUT=900s

# DCloud/HBuilderX credentials. Keep this file mode 600 and do not commit values.
HBUILDERX_USERNAME=
HBUILDERX_PASSWORD=

# Optional release-note text shown in App update metadata.
WGT_UPDATE_NOTES=资源更新与问题修复
