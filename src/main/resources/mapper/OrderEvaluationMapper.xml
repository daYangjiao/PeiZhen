<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.dao.OrderEvaluationMapper">

    <resultMap id="OrderEvaluationResultMap" type="org.example.model.OrderEvaluation">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="attendant_id" property="attendantId"/>
        <result column="rating" property="rating"/>
        <result column="tags" property="tags"/>
        <result column="content" property="content"/>
        <result column="attendant_reply" property="attendantReply"/>
        <result column="reply_time" property="replyTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByOrderId" parameterType="int" resultMap="OrderEvaluationResultMap">
        SELECT * FROM order_evaluation WHERE order_id = #{orderId}
    </select>

    <insert id="insert" parameterType="org.example.model.OrderEvaluation" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO order_evaluation (
            order_id, order_no, user_id, attendant_id,
            rating, tags, content, create_time, update_time
        ) VALUES (
            #{orderId}, #{orderNo}, #{userId}, #{attendantId},
            #{rating}, #{tags}, #{content}, NOW(), NOW()
        )
    </insert>

    <update id="updateByOrderId" parameterType="org.example.model.OrderEvaluation">
        UPDATE order_evaluation
        <set>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="attendantId != null">attendant_id = #{attendantId},</if>
            <if test="rating != null">rating = #{rating},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="content != null">content = #{content},</if>
            <if test="attendantReply != null">attendant_reply = #{attendantReply},</if>
            <if test="replyTime != null">reply_time = #{replyTime},</if>
            update_time = NOW()
        </set>
        WHERE order_id = #{orderId}
    </update>

</mapper>

