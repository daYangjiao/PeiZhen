<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.dao.AttendantQualificationAuditLogMapper">

    <resultMap id="AttendantQualificationAuditLogResultMap" type="org.example.model.AttendantQualificationAuditLog">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="actor_type" property="actorType"/>
        <result column="actor_id" property="actorId"/>
        <result column="actor_name" property="actorName"/>
        <result column="actor_phone" property="actorPhone"/>
        <result column="actor_role" property="actorRole"/>
        <result column="action" property="action"/>
        <result column="from_status" property="fromStatus"/>
        <result column="to_status" property="toStatus"/>
        <result column="reason" property="reason"/>
        <result column="snapshot_json" property="snapshotJson"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="org.example.model.AttendantQualificationAuditLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO attendant_qualification_audit_log (
            user_id,
            actor_type,
            actor_id,
            actor_name,
            actor_phone,
            actor_role,
            action,
            from_status,
            to_status,
            reason,
            snapshot_json
        ) VALUES (
            #{userId},
            #{actorType},
            #{actorId},
            #{actorName},
            #{actorPhone},
            #{actorRole},
            #{action},
            #{fromStatus},
            #{toStatus},
            #{reason},
            #{snapshotJson}
        )
    </insert>

    <select id="findLatestByUserId" resultMap="AttendantQualificationAuditLogResultMap">
        SELECT *
        FROM attendant_qualification_audit_log
        WHERE user_id = #{userId}
        ORDER BY create_time DESC, id DESC
        LIMIT #{limit}
    </select>

</mapper>
