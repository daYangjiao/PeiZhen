<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.dao.UserMapper">

    <resultMap id="UserResultMap" type="org.example.model.User">
        <id column="id" property="id"/>
        <result column="password" property="password"/>
        <result column="name" property="name"/>
        <result column="phone" property="phone"/>
        <result column="sex" property="sex"/>
        <result column="age" property="age"/>
        <result column="avatar" property="avatar"/>
        <result column="user_type" property="userType"/>
        <result column="status" property="status"/>
        <result column="openid" property="openid"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 查询所有用户 -->
    <select id="findAll" resultMap="UserResultMap">
        SELECT * FROM user
    </select>

    <!-- 根据 ID 查询用户 -->
    <select id="findById" parameterType="int" resultMap="UserResultMap">
        SELECT * FROM user WHERE id = #{id}
    </select>

    <!-- 保存用户 -->
    <insert id="save" parameterType="org.example.model.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (password, name, phone, sex, age, avatar, user_type, status, openid)
        VALUES (#{password}, #{name}, #{phone}, #{sex}, #{age}, #{avatar}, #{userType}, #{status}, #{openid})
    </insert>

    <!-- 更新用户信息 -->
    <update id="update" parameterType="org.example.model.User">
        UPDATE user
        <set>
            <if test="password != null">password = #{password},</if>
            <if test="name != null">name = #{name},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="sex != null">sex = #{sex},</if>
            <if test="age != null">age = #{age},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="userType != null">user_type = #{userType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="openid != null">openid = #{openid},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据 ID 删除用户 -->
    <delete id="delete" parameterType="int">
        DELETE FROM user WHERE id = #{id}
    </delete>

    <!-- 根据手机号查询用户 -->
    <select id="findByPhone" parameterType="string" resultMap="UserResultMap">
        SELECT * FROM user WHERE phone = #{phone} LIMIT 1
    </select>

    <!-- 根据 openid 查询用户 -->
    <select id="findByOpenid" parameterType="string" resultMap="UserResultMap">
        SELECT * FROM user WHERE openid = #{openid} LIMIT 1
    </select>

    <select id="countAdminUsers" resultType="int">
        SELECT COUNT(*)
        FROM user
        <where>
            <if test="userType != null">AND user_type = #{userType}</if>
            <if test="status != null">AND status = #{status}</if>
            <if test="keyword != null and keyword != ''">
                AND (
                    CAST(id AS CHAR) = #{keyword}
                    OR name LIKE CONCAT('%', #{keyword}, '%')
                    OR phone LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
    </select>

    <select id="findAdminUsers" resultMap="UserResultMap">
        SELECT *
        FROM user
        <where>
            <if test="userType != null">AND user_type = #{userType}</if>
            <if test="status != null">AND status = #{status}</if>
            <if test="keyword != null and keyword != ''">
                AND (
                    CAST(id AS CHAR) = #{keyword}
                    OR name LIKE CONCAT('%', #{keyword}, '%')
                    OR phone LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
        ORDER BY create_time DESC, id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByUserType" resultType="long">
        SELECT COUNT(*)
        FROM user
        WHERE user_type = #{userType}
    </select>

    <select id="countByUserTypeAndStatus" resultType="long">
        SELECT COUNT(*)
        FROM user
        WHERE user_type = #{userType}
          AND status = #{status}
    </select>

</mapper>
