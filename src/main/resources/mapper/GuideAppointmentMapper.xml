<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.dao.GuideAppointmentMapper">

    <resultMap id="GuideAppointmentResultMap" type="org.example.model.GuideAppointment">
        <id column="id" property="id"/>
        <result column="appointment_no" property="appointmentNo"/>
        <result column="user_id" property="userId"/>
        <result column="patient_name" property="patientName"/>
        <result column="patient_phone" property="patientPhone"/>
        <result column="symptoms" property="symptoms" typeHandler="org.example.handler.JsonStringListTypeHandler"/>
        <result column="hospital_name" property="hospitalName"/>
        <result column="service_type_number" property="serviceTypeNumber"/>
        <result column="service_date" property="serviceDate"/>
        <result column="service_start_time" property="serviceStartTime"/>
        <result column="service_end_time" property="serviceEndTime"/>
        <result column="other_requirement" property="otherRequirement"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insertGuideAppointment" parameterType="org.example.model.GuideAppointment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO guide_appointment (
            appointment_no, user_id, patient_name, patient_phone, symptoms,
            hospital_name, service_type_number, service_date, service_start_time, service_end_time,
            other_requirement, create_time
        ) VALUES (
            #{appointmentNo}, #{userId}, #{patientName}, #{patientPhone},
            #{symptoms, typeHandler=org.example.handler.JsonStringListTypeHandler},
            #{hospitalName}, #{serviceTypeNumber}, #{serviceDate}, #{serviceStartTime}, #{serviceEndTime},
            #{otherRequirement}, #{createTime}
        )
    </insert>

    <select id="selectByAppointmentNo" parameterType="string" resultMap="GuideAppointmentResultMap">
        SELECT * FROM guide_appointment WHERE appointment_no = #{appointmentNo}
    </select>
    
    <select id="selectLatest" resultMap="GuideAppointmentResultMap">
        SELECT * FROM guide_appointment ORDER BY create_time DESC LIMIT 1
    </select>

</mapper>