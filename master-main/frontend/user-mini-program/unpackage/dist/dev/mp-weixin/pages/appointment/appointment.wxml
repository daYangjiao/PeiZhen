<view class="container"><view class="header"><text class="title">预约类型选择</text></view><view class="service-types"><view class="service-row"><view class="{{['service-item', b && 'selected']}}" bindtap="{{c}}"><image class="service-icon" src="{{a}}" mode="aspectFit"></image><text class="service-title">普通陪诊</text><text class="service-desc">专业陪诊师 贴心服务</text></view><view class="{{['service-item', e && 'selected']}}" bindtap="{{f}}"><image class="service-icon" src="{{d}}" mode="aspectFit"></image><text class="service-title">术后护理</text><text class="service-desc">专业术后照顾 安心恢复</text></view></view><view class="service-row"><view class="{{['service-item', h && 'selected']}}" bindtap="{{i}}"><image class="service-icon" src="{{g}}" mode="aspectFit"></image><text class="service-title">急诊陪同</text><text class="service-desc">紧急情况 快速响应</text></view><view class="{{['service-item', k && 'selected']}}" bindtap="{{l}}"><image class="service-icon" src="{{j}}" mode="aspectFit"></image><text class="service-title">上门陪诊</text><text class="service-desc">专门专业陪诊师 贴心陪伴</text></view></view></view><view class="service-details"><block wx:if="{{m}}"><text class="details-title">{{n}}</text><view wx:for="{{o}}" wx:for-item="detail" wx:key="c" class="detail-item"><image class="detail-icon" src="{{detail.a}}" mode="aspectFit"></image><text class="detail-text">{{detail.b}}</text></view></block><block wx:else><text class="details-title">请选择服务类型</text><view class="detail-item"><text class="detail-text">请先选择上方的服务类型以查看详细信息</text></view></block></view><view class="recommended-section"><text class="section-title">推荐陪诊员</text><view class="companion-list"><view wx:for="{{p}}" wx:for-item="companion" wx:key="i" class="{{['companion-card', companion.h && 'selected']}}" bindtap="{{companion.j}}"><image class="companion-avatar" src="{{companion.a}}" mode="aspectFill"></image><view class="companion-info"><text class="companion-name">{{companion.b}}</text><view class="companion-rating"><text class="rating-star">★</text><text class="rating-score">{{companion.c}}</text><text class="rating-count">({{companion.d}})</text><text class="experience">{{companion.e}}</text></view><view class="companion-tags"><text wx:for="{{companion.f}}" wx:for-item="tag" wx:key="b" class="tag">{{tag.a}}</text></view></view><text class="companion-price">¥{{companion.g}}/小时</text></view></view></view><view class="bottom-button"><button class="next-btn" bindtap="{{q}}">下一步</button></view></view>