
/* --- 保持原有样式不变 --- */
.container.data-v-2e88df03 {
  padding: 0 32rpx;
  background-color: #ffffff;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 120rpx; /* 为底部导航栏预留空间 */
}

/* 订单号区域 */
.order-info.data-v-2e88df03 {
  padding: 26rpx 10rpx 20rpx 20rpx;
  margin-bottom: 32rpx;
}
.header-row.data-v-2e88df03 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #666;
  font-weight: bold;
}
.label.data-v-2e88df03 {
  /* “订单号” 文字 */
}
.status-tag.data-v-2e88df03 {
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: white;
  background-color: #e8f5e8;
}
.status-assigned.data-v-2e88df03 {
  /* 修改：新增 '待陪诊师接单' 状态样式 */
  background-color: #e3f2fd;
  color: #1976d2;
}
.status-pending.data-v-2e88df03 {
  background-color: #fff3e0;
  color: #f57c00;
}
.status-cancelled.data-v-2e88df03 {
  background-color: #ffebee;
  color: #d32f2f;
}
.status-in-progress.data-v-2e88df03 {
  background-color: #e8f5e8;
  color: #4caf50;
}
.status-completed.data-v-2e88df03 {
  background-color: #e0e0e0;
  color: #616161;
}
.order-number.data-v-2e88df03 {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-top: 8rpx;
}

/* 服务信息 */
.service-info.data-v-2e88df03 {
  padding: 10rpx 10rpx 20rpx 20rpx;
  margin-bottom: 20rpx;
}
.info-item.data-v-2e88df03 {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}
.label.data-v-2e88df03 {
  color: #666;
  width: 180rpx;
}
.value.data-v-2e88df03 {
  color: #333;
}

/* 陪诊师信息 */
.companion-info.data-v-2e88df03 {
  padding: 0rpx 10rpx 0rpx 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.avatar.data-v-2e88df03 {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  flex-shrink: 0; /* 防止头像被压缩 */
}
.companion-details.data-v-2e88df03 {
  flex: 1;
  position: relative;
}
.name.data-v-2e88df03 {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
}
.phone.data-v-2e88df03 {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.phone-icon.data-v-2e88df03 {
  width: 12px; /* 调整图片大小 */
  height: 12px;
}
.phone-number.data-v-2e88df03 {
  color: #666;
}
.rating.data-v-2e88df03 {
  font-size: 24rpx;
  color: #FFB300; /* 星星保持金色 */
  
  display: flex;
  align-items: center;
  gap: 6rpx;
  float: right; /* 靠右对齐 */
}
.score.data-v-2e88df03 {
  color: #333; /* 评分数字为深色 */
}

/* 支付信息 */
.payment-info.data-v-2e88df03 {
  padding: 26rpx 10rpx 20rpx 20rpx;
  margin-bottom: 20rpx;
}
.payment-row.data-v-2e88df03 {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}
.label.data-v-2e88df03 {
  color: #666;
}
.price.data-v-2e88df03 {
  color: #e53935;
  font-weight: bold;
}
.method.data-v-2e88df03 {
  color: #666;
}
.time.data-v-2e88df03 {
  color: #999;
}

/* 服务记录整体 */
.record-section.data-v-2e88df03 {
  background-color: white;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 20rpx; /* 为取消订单按钮留出空间 */
}
.record-title.data-v-2e88df03 {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 32rpx;
} /* 主标题：调小字体 */
.step-title.data-v-2e88df03 {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  display: block;
} /* 辅助说明 */
.step-desc.data-v-2e88df03 {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
  margin-top: 6rpx;
  word-wrap: break-word;
  overflow-wrap: break-word;
  max-width: 400rpx;
  display: block;
}
.step-time.data-v-2e88df03 {
  font-size: 22rpx;
  color: #999;
  text-align: right;
  flex-shrink: 0;
  width: 160rpx;
}

/* 每一步的布局 */
.step-item.data-v-2e88df03 {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx; /* 行间距更舒适 */
}
.step-dot.data-v-2e88df03 {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #149DE4;
  margin-top: 12rpx;
  flex-shrink: 0;
}
.step-content.data-v-2e88df03 {
  flex: 1;
  min-width: 0;
}

/* 新增：取消订单按钮样式 */
.cancel-order-section.data-v-2e88df03 {
  padding: 0 32rpx 20rpx 32rpx;
  margin-bottom: 20rpx; /* 为底部导航栏留出空间 */
}
.cancel-order-btn.data-v-2e88df03 {
  width: 100%;
  height: 80rpx;
  background-color: #f57c00; /* 橙色背景，表示警告操作 */
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(245, 124, 0, 0.2);
}

/* 底部导航栏 */
.bottom-nav.data-v-2e88df03 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-top: 1rpx solid #eee;
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 140rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 999;
}
.nav-item.data-v-2e88df03 {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #149DE4;
}

/* 底部导航栏图标 */
.nav-icon.data-v-2e88df03 {
  width: 46rpx;
  height: 46rpx;
}
.return-to-orders-section.data-v-2e88df03 {
  padding: 50rpx 32rpx 20rpx 32rpx;
  margin-bottom: 20rpx;
}
.return-to-orders-btn.data-v-2e88df03 {
  width: 100%;
  height: 80rpx;
  background-color: #149DE4;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(20, 157, 228, 0.2);
}
