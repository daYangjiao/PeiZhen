
/* 样式与之前保持一致，确保二维码居中显示 */
.payment-success-page.data-v-d6d97d31 {
  background-color: #f5f5f5;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  min-height: 100vh;
}
.back-btn.data-v-d6d97d31 {
  display: flex;
  align-items: center;
  margin: 20rpx 0 30rpx;
  color: #333;
  font-size: 32rpx;
}
.back-icon.data-v-d6d97d31 {
  font-size: 36rpx;
}
.card.data-v-d6d97d31 {
  background-color: white;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}
.success-card.data-v-d6d97d31 {
  text-align: center;
}
.icon.data-v-d6d97d31 {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 50%;
  background-color: #00d46c;
  color: white;
  font-size: 48rpx;
  margin: 0 auto 20rpx;
}
.main-title.data-v-d6d97d31 {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin: 20rpx 0 16rpx;
}
.desc.data-v-d6d97d31 {
  color: #666;
  font-size: 28rpx;
  line-height: 1.5;
  padding: 0 20rpx;
  margin-bottom: 100rpx; /* 为按钮留出空间 */
}
/* 新增：查看订单详情按钮样式 */
.view-order-btn.data-v-d6d97d31 {
  width: 240rpx; /* 调整宽度 */
  height: 60rpx;
  background-color: #ffffff; /* 白色背景 */
  color: #007AFF; /* 蓝色文字 */
  border: 1rpx solid #007AFF; /* 蓝色边框 */
  border-radius: 30rpx; /* 圆角 */
  font-size: 28rpx;
  line-height: 60rpx; /* 垂直居中 */
  margin: 20rpx auto 0; /* 上外边距，水平居中 */
  display: block; /* 使其表现为块级元素以便居中 */
}
.card .title.data-v-d6d97d31 {
  font-weight: bold;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  color: #333;
}
.qr-code-card .title.data-v-d6d97d31 {
  justify-content: center;
}
.card .title text.data-v-d6d97d31 {
  margin-right: 10rpx;
  color: #007AFF;
}
.info-item.data-v-d6d97d31 {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eee;
}
.info-item.data-v-d6d97d31:last-child {
  border-bottom: none;
}
.label.data-v-d6d97d31 {
