/* --- 新增：模态框样式 --- */
.modal-overlay.data-v-fa941edb {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  padding: 20rpx;
}
.modal-content.data-v-fa941edb {
  background-color: white;
  border-radius: 16rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
}
.modal-header.data-v-fa941edb {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
  background-color: #f8f9fa;
}
.modal-title.data-v-fa941edb {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.close-btn.data-v-fa941edb {
  font-size: 40rpx;
  color: #999;
  cursor: pointer;
  line-height: 1;
  padding: 0 10rpx;
}
.modal-body.data-v-fa941edb {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
  font-size: 24rpx; /* 调整字体大小以适应屏幕 */
  line-height: 1.5; /* 增加行间距 */
  color: #333;
}
.rule-text.data-v-fa941edb {
  white-space: pre-wrap; /* 保留换行符和空格 */
  word-break: break-word; /* 防止长单词溢出 */
}
.modal-footer.data-v-fa941edb {
  padding: 20rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  justify-content: center;
}
.close-modal-btn.data-v-fa941edb {
  padding: 10rpx 30rpx;
  background-color: #007bff;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  cursor: pointer;
}


