  color: #ffffff !important;
  opacity: 0.6;
  cursor: not-allowed;
}

/* --- 新增：费用明细卡片内的小字“查看计费规则”按钮 --- */
.rule-link-button.data-v-fa941edb {
  /* 设置为行内块元素，使其不脱离文本流 */
  display: inline-block;
  /* 为了使按钮在右上角对齐，可以使用绝对定位或 flex */
  /* 这里采用相对定位 + margin-left 方式，也可以使用 Flex 布局 */
  margin-left: auto; /* 或者使用 flex 布局 */
  padding: 0; /* 去掉默认 padding */
  border: none; /* 去掉默认边框 */
  background: none; /* 去掉默认背景 */
  color: #007aff; /* 蓝色文字 */
  font-size: 24rpx; /* 小字 */
  text-decoration: underline; /* 下划线 */
  cursor: pointer;
  line-height: 1; /* 控制行高 */
  margin-top: -10rpx; /* 微微向上调整 */
  margin-right: 10rpx; /* 右侧留白 */
  /* 可以添加 hover 效果 */
  /* &:hover {
    color: #0056b3;
  } */
}

