}

/* 匹配动画遮罩层 */
.matching-overlay.data-v-1314d952 {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5); /* 半透明黑色背景 */
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999; /* 确保遮罩层在最顶层 */
}

/* 匹配动画容器 */
.matching-container.data-v-1314d952 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px; /* 圆圈和文字之间的间距 */
}

/* 匹配动画圆形 */
.matching-circle.data-v-1314d952 {
  width: 50px;
  height: 50px;
  border: 4px solid #007AFF; /* 圆圈边框颜色 */
  border-top-color: transparent; /* 顶部边框透明，形成缺口 */
  border-radius: 50%; /* 形成圆形 */
  animation: spin-1314d952 1s linear infinite; /* 应用旋转动画 */
}

/* 旋转动画定义 */
@keyframes spin-1314d952 {
0% {
    transform: rotate(0deg);
}
100% {
    transform: rotate(360deg);
}
}

/* 匹配文字 */
.matching-text.data-v-1314d952 {
  color: white;
  font-size: 16px;
  font-weight: bold;
}
.hint.data-v-1314d952 {
  text-align: center;
  font-size: 12px;
  color: #999;
  margin-top: 8px;
  margin-left: 5px;
}
.input-textarea.data-v-1314d952 {
  width: 100%;
  min-height: 80px;
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 8px;
  font-size: 14px;
  background: #fff;
  color: #333;
  box-sizing: border-box;
  resize: none;
}
