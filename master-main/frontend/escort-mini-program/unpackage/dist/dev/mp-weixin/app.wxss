/* 通用组件样式 */
/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  padding-top: var(--status-bar-height);
  background-color: var(--primary-color);
}
.custom-navbar .navbar-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 15px;
}
.custom-navbar .navbar-content .nav-left, .custom-navbar .navbar-content .nav-right {
  width: 60px;
  height: 44px;
  display: flex;
  align-items: center;
}
.custom-navbar .navbar-content .nav-right {
  justify-content: flex-end;
}
.custom-navbar .navbar-content .nav-icon {
  width: 24px;
  height: 24px;
  filter: brightness(0) invert(1);
}
.custom-navbar .navbar-content .nav-title {
  flex: 1;
  text-align: center;
  font-size: 18px;
  font-weight: 600;
  color: #ffffff;
}
/* 卡片样式 */
.card {
  background-color: var(--bg-primary);
  border-radius: var(--radius-medium);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-light);
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}
.card-header .card-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
}
/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 16px;
  border: none;
  border-radius: var(--radius-large);
  font-size: 14px;
  font-weight: 600;
  transition: all 0.3s ease;
  cursor: pointer;
}
.btn:active {
  transform: scale(0.98);
}
.btn.btn-primary {
  background-color: var(--primary-color);
  color: #ffffff;
}
.btn.btn-primary:active {
  background-color: var(--primary-dark);
}
.btn.btn-primary:disabled {
  background-color: var(--bg-disabled);
  color: var(--text-disabled);
}
.btn.btn-secondary {
  background-color: var(--bg-secondary);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}
.btn.btn-secondary:active {
  background-color: var(--bg-disabled);
}
.btn.btn-success {
  background-color: var(--success-color);
  color: #ffffff;
}
.btn.btn-warning {
  background-color: var(--warning-color);
  color: #ffffff;
}
.btn.btn-error {
  background-color: var(--error-color);
  color: #ffffff;
}
.btn.btn-small {
  padding: 6px 12px;
  font-size: 12px;
  border-radius: 15px;
}
.btn.btn-large {
  padding: 12px 24px;
  font-size: 16px;
  border-radius: 22px;
}
/* 输入框样式 */
.input {
  width: 100%;
  height: 44px;
  padding: 0 15px;
  background-color: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-large);
  font-size: 16px;
  color: var(--text-primary);
  transition: border-color 0.3s ease;
}
.input:focus {
  border-color: var(--primary-color);
}
.input::-webkit-input-placeholder {
  color: var(--text-placeholder);
}
.input::placeholder {
  color: var(--text-placeholder);
}
.input:disabled {
  background-color: var(--bg-disabled);
  color: var(--text-disabled);
}
/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4px 8px;
  border-radius: var(--radius-small);
  font-size: 12px;
  font-weight: 500;
}
.tag.tag-primary {
  background-color: rgba(74, 144, 226, 0.1);
  color: var(--primary-color);
}
.tag.tag-success {
  background-color: rgba(82, 196, 26, 0.1);
  color: var(--success-color);
}
.tag.tag-warning {
  background-color: rgba(250, 173, 20, 0.1);
  color: var(--warning-color);
}
.tag.tag-error {
  background-color: rgba(255, 77, 79, 0.1);
  color: var(--error-color);
}
/* 分割线 */
.divider {
  height: 1px;
  background-color: var(--divider-color);
  margin: var(--spacing-lg) 0;
}
.divider-vertical {
  width: 1px;
  height: 100%;
  background-color: var(--divider-color);
  margin: 0 var(--spacing-lg);
}
/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
}
.empty-state .empty-icon {
  width: 80px;
  height: 80px;
  margin-bottom: var(--spacing-lg);
  opacity: 0.6;
}
.empty-state .empty-text {
  font-size: 14px;
  color: var(--text-placeholder);
  text-align: center;
  line-height: 1.5;
}
/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
}
.loading .loading-text {
  font-size: 14px;
  color: var(--text-placeholder);
  margin-left: var(--spacing-sm);
}
/* 头像样式 */
.avatar {
  border-radius: var(--radius-round);
  overflow: hidden;
  border: 2px solid var(--border-light);
}
.avatar.avatar-small {
  width: 32px;
  height: 32px;
}
.avatar.avatar-medium {
  width: 44px;
  height: 44px;
}
.avatar.avatar-large {
  width: 60px;
  height: 60px;
}
/* 状态标签 */
.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 10px;
  font-weight: 600;
}
.status-tag.status-pending {
  background-color: #e3f2fd;
  color: #1976d2;
}
.status-tag.status-accepted {
  background-color: #e8f5e8;
  color: #2e7d32;
}
.status-tag.status-progress {
  background-color: #fff3e0;
  color: #f57c00;
}
.status-tag.status-completed {
  background-color: #e8f5e8;
  color: #2e7d32;
}
.status-tag.status-cancelled {
  background-color: #ffebee;
  color: #c62828;
}
/* 响应式适配 */
@media (max-width: 375px) {
.container {
    padding: 0 12px;
}
.card {
    padding: 12px;
    margin-bottom: 10px;
}
.btn {
    padding: 6px 12px;
    font-size: 13px;
}
.input {
    height: 40px;
    font-size: 14px;
}
}
/* 动画效果 */
@keyframes fadeIn {
from {
    opacity: 0;
    transform: translateY(20px);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}
@keyframes slideIn {
from {
    transform: translateX(-100%);
}
to {
    transform: translateX(0);
}
}
.fade-in {
  animation: fadeIn 0.3s ease-out;
}
.slide-in {
  animation: slideIn 0.3s ease-out;
}
/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
.safe-area-top {
  padding-top: env(safe-area-inset-top);
}
/* 滚动条样式 */
::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 2px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 0, 0, 0.3);
